{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|mp4|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      480,
      828,
      1200,
      1920,
      2560
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400
  }
}